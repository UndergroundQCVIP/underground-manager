# ==============================================================================
# LA CONFRÉRIE — Environment Configuration Template
# Phases UG-01 → UG-04
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Public club name used in every user-facing message (UG-04).
# Internal identifiers, database keys and the BotFather username are NOT affected.
CLUB_DISPLAY_NAME="LA CONFRÉRIE"

# Telegram Bot Username without @ prefix (used for deep linking from public directory)
# Keep the existing live username unless you have explicitly renamed the bot in BotFather.
BOT_USERNAME=UndergroundManagerBot

# Webhook Secret Token for Telegram Webhook Verification (header: X-Telegram-Bot-Api-Secret-Token)
# REQUIRED in webhook mode in every environment (16-256 chars of A-Z a-z 0-9 _ -). The app refuses to start without it.
WEBHOOK_SECRET=your_secure_webhook_secret_here

# Administrator Telegram Numeric User IDs (comma-separated, immutable user IDs)
# Example: 123456789,987654321
ADMIN_USER_IDS=123456789

# Telegram Spaces Configuration (Numeric Chat IDs with -100 prefix)
# TOKEBEC VIP COLLECTIONS (Forum Group with Topics enabled) [Paid/Private]
VIP_COLLECTIONS_CHAT_ID=-1001234567890
# RETRO | LA CONFRÉRIE (Forum Group with Topics enabled) [Retro Plus only] [UG-04]
# Leave unset/0 to run without the Retro tier.
TELEGRAM_RETRO_FORUM_CHAT_ID=-1003975562920
# Public Creator Directory (Public Channel) [UG-02]
PUBLIC_DIRECTORY_CHAT_ID=-1001234567893
# Optional public t.me link of the directory channel (used by the welcome/lobby buttons) [UG-05]
PUBLIC_DIRECTORY_URL=

# UG-07 Optional channel for the bot-managed leaderboard post (bot must be admin: post/edit/pin)
TELEGRAM_LEADERBOARD_CHAT_ID=

# UG-05 Public discovery (all optional; leave blank to use the bot's own info pages instead)
# Public information group "LA CONFRÉRIE | ACCUEIL" - NEVER one of the private spaces.
# Telegram bots cannot create groups: create it by hand, add the bot as admin
# (post / edit / pin messages), then paste its numeric ID (-100...) and public link.
TELEGRAM_PUBLIC_LOBBY_CHAT_ID=
TELEGRAM_PUBLIC_LOBBY_URL=
# Public welcome channel that carries the bot-managed welcome menu
TELEGRAM_PUBLIC_WELCOME_CHAT_ID=

# UG-05 How members obtain access before an admin changes it in Settings:
# contribution_only (default) | contributions_and_stars | stars_only
MEMBERSHIP_MODE=contribution_only
# Wanted List (Private Channel) [Paid/Private] [UG-02]
WANTED_LIST_CHAT_ID=-1001234567891
# LA CONFRÉRIE General Chat (Private Group) [Paid/Private]
GENERAL_CHAT_ID=-1001234567892

# Telegram Stars Recurring Subscription Configuration
# Default: 750 Stars for 30 days (2,592,000 seconds)
# Regular plan price:
STARS_PRICE_AMOUNT=750
# Retro Plus plan price (UG-04). Intentionally BLANK/0: Retro Plus billing stays
# disabled until the owner approves and sets a price here.
RETRO_PLUS_STARS_PRICE_AMOUNT=
STARS_SUBSCRIPTION_PERIOD_SECONDS=2592000
CURRENCY=XTR

# UG-02 Creator Directory & Voting Options
# Only the HOUR field is used: daily sync runs at that hour America/Toronto time (default 3). Deno.cron itself is UTC.
DIRECTORY_UPDATE_CRON=0 3 * * *
# Monthly voting active period in days (default: 5)
VOTING_PERIOD_DAYS=5
# Maximum number of top supported candidates included on the voting ballot (default: 5)
VOTING_SHORTLIST_SIZE=5
# Optional weekly creator update digest in General Chat (default: false)
DIGEST_ENABLED=false

# UG-03 Treasury & Expense Options
# Base financial reporting currency (default: CAD)
BASE_CURRENCY=CAD
# Configurable Telegram Stars reward valuation reference in USD (default: 0.013 = US$0.013/Star)
DEFAULT_STARS_REWARD_VALUATION_USD=0.013
# Channel for monthly treasury reports (numeric chat ID, or 0 to use WANTED_LIST_CHAT_ID)
TREASURY_REPORT_CHANNEL_ID=0
# Public exchange rate endpoint for fiat conversion
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# UG-04 Regular → Retro migration tuning
# Max message IDs per copyMessages call (1-100) and pause between batches (ms)
MIGRATION_BATCH_SIZE=30
MIGRATION_BATCH_DELAY_MS=3000

# Bot Execution Mode: 'webhook' (default on Deno Deploy) or 'polling' (for local testing)
BOT_MODE=webhook
PORT=8000

# Environment: 'production', 'development', or 'test'
DENO_ENV=development

# Support handle displayed to members (/paysupport)
SUPPORT_USERNAME=@UndergroundSupport

